# Required — obtain from https://platform.openai.com/api-keys
OPENAI_API_KEY="your_openai_api_key_here"

# Optional — weather API defaults (Open-Meteo, no key required)
# Override only if you need a different default fallback location
# when waypoints cannot be parsed from the PDF.
WEATHER_TZ="America/New_York"
WEATHER_LAT="40.7282"
WEATHER_LON="-74.0776"
